{
  "manifest_version": 3,
  "name": "GoSaveTool: Save Image as PNG, JPG, WebP",
  "short_name": "GoSaveTool",
  "version": "1.0.0",
  "description": "Right-click any image to save it as PNG, JPG or WebP, or compress it. Count words and characters of selected text. Nothing uploaded.",
  "homepage_url": "https://www.gosavetool.com/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "GoSaveTool text tools",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "bg.js", "scripts": ["bg.js"] },
  "permissions": ["contextMenus", "downloads", "notifications", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gosavetool@gosavetool.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
